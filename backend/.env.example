DEBUG=True
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=*

# 腾讯云 COS（图片存储，B 负责）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET_ORIGINAL=lostfound-original-1470644056
COS_BUCKET_THUMB=lostfound-thumb-1470644056

# 短信（阿里云 PNVS，B 负责；四项留空则走 dev 模式，验证码在 dev_code 返回）
# 签名/模板用号码认证控制台「系统赠送」的（免自建免审核）：签名名称 + 模板 CODE（如 100001）
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=

# 阿里云百炼 Embedding（E 负责；Key 只放本机/服务器 .env，不要提交）
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# 缓存（B 负责；留空走 locmem 本地开发，填了走 Redis 跨进程共享）
# Redis URL 格式：redis://[:password@]host:port/db
# 本地开发留空即可；部署/多 worker 联调时填，例：redis://127.0.0.1:6379/0
REDIS_URL=

# CORS（B 负责；默认全放开供前端联调，生产收紧到具体来源）
# 生产 .env 设置下面两行（注意：ALLOW_ALL=true 时白名单不生效）：
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://your-domain.com,http://118.25.145.183

# 部署相关由 B 在 infra 中补充，本地开发默认使用 SQLite。
# DATABASE_URL、地图等密钥一律通过环境变量注入，不写入仓库。
